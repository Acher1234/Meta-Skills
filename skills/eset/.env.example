# ESET Connect credentials (per-workspace — next to registered SKILL.md)
# Resolved via SkillCred("eset", [".env"]) + CURRENT_SKILL_DIRECTORY

# Region base WITHOUT /oauth/token (eu|de|us|ca|jpn):
ESET_URL=https://eu.business-account.iam.eset.systems
ESET_USERNAME=you@example.com
ESET_PASSWORD=your-password

# Filled automatically by `python cli.py token` / first API call:
# ESET_ACCESS_TOKEN=
# ESET_REFRESH_TOKEN=
# ESET_TOKEN_EXPIRES_IN=

# Optional gateway overrides (else derived from ESET_URL region):
# ESET_API_URL=https://eu.automation.eset.systems
# ESET_APP_URL=https://eu.application-management.eset.systems
# ESET_ASSET_URL=https://eu.automation.eset.systems
# ESET_POLICY_URL=https://eu.automation.eset.systems
# ESET_INCIDENT_URL=https://eu.incident-management.eset.systems
# ESET_AUTOMATION_URL=https://eu.automation.eset.systems
