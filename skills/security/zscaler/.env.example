# Zscaler — SkillCred .env (next to registered SKILL.md)
# Nested JSON keys use __ as separator: zpa.client_id → ZPA__CLIENT_ID

# ZPA (Zero Trust Private Access)
ZPA__CLIENT_ID=
ZPA__CLIENT_SECRET=
ZPA__CUSTOMER_ID=
ZPA__CLOUD=ZPATWO
ZPA__MICROTENANT_ID=0

# ZIA (Internet Access)
ZIA__USERNAME=
ZIA__PASSWORD=
ZIA__API_KEY=
ZIA__CLOUD=zscaler

# ZIdentity
ZIDENTITY__CLIENT_ID=
ZIDENTITY__CLIENT_SECRET=
ZIDENTITY__VANITY_DOMAIN=
ZIDENTITY__CLOUD=
ZIDENTITY__CUSTOMER_ID=
