# Folders + password for non-interactive encrypt / decrypt
# Resolved via SkillCred("folder-crypt", [".env"]) + CURRENT_SKILL_DIRECTORY
# Interactive CLI prompts when these are omitted.
#
# FOLDER is a comma-separated list of files or folders (whitespace around commas
# is ignored). Relative paths start at PROJECT_PATH, the main project folder
# (shell export, not a key in this file).

FOLDER=to_encrypt,secrets,notes.txt
PASSWORD=change-me
