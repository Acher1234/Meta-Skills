# Easiest way to fill this file: `python scripts/cli.py setup` (guided, writes it for you).
#
# Pick ONE authentication method.
#
# A) Email + master password — nothing to copy, but two-step login prompts for a code
#    (`cli.py unlock --code 123456`).
BW_EMAIL=

# B) Personal API key — immune to two-step login prompts.
#    Web Vault > Account settings > Security > Keys > View API Key
#    https://bitwarden.com/help/personal-api-key/
#    It authenticates but does NOT unlock: the master password is still required by
#    `cli.py unlock`, and is never stored here.
BW_CLIENTID=
BW_CLIENTSECRET=

# Cloud US (default), Cloud EU (https://vault.bitwarden.eu), or a self-hosted URL
BW_SERVER=https://vault.bitwarden.com

# Minutes a cached session key stays valid before `unlock` is required again
BW_SESSION_TTL=15

# Only if bw reports "unable to get local issuer certificate" (TLS-inspecting
# proxy or self-hosted server with a private CA): absolute path to a .pem bundle
# NODE_EXTRA_CA_CERTS=

# Silent unlock from the macOS keychain. Set by `cli.py keychain set`; leave empty
# to keep the interactive prompt. Account defaults to BW_EMAIL.
# BW_PASSWORD_KEYCHAIN_SERVICE=meta-skills-bitwarden
# BW_PASSWORD_KEYCHAIN_ACCOUNT=
