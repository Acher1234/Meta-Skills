# Optional — every key can stay empty.
# By default tokens are read from the tools' own files:
#   project skill (IS_GLOBAL=FALSE): <project>/.claude, .codex, .opencode first, then the computer's
#   global skill  (IS_GLOBAL=TRUE):  the computer's (~/.claude, ~/.codex, ~/.local/share/opencode)
#   then Hermes (~/.hermes/auth.json, .env), OpenClaw (~/.openclaw/agents/*/agent/auth-profiles.json, .env), env vars

# Force a credentials file (absolute path)
CLAUDE_CREDENTIALS_FILE=
CODEX_AUTH_FILE=
OPENCODE_AUTH_FILE=

# Optional HTTP / proxy settings (see meta-skill-common/http)
# HTTP_TIMEOUT=20
# PROXY_URL=
