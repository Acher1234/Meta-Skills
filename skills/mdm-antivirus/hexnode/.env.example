# Hexnode MDM — SkillCred .env (next to registered SKILL.md)
# Enable API: Admin → API → Enable API Access, then copy the key.
# Docs: https://www.hexnode.com/mobile-device-management/developers/setting-up-an-api/authentication/

HEXNODE_API_KEY=

# Portal subdomain only (→ https://<portal>.hexnodemdm.com/api/v1)
HEXNODE_PORTAL=yourportal

# Or set the full API base (overrides portal):
# HEXNODE_BASE_URL=https://yourportal.hexnodemdm.com/api/v1
