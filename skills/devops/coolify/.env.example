# Coolify instance + API token — copy to `.env` next to the registered SKILL.md (gitignored).
# Token: <COOLIFY_URL>/security/api-tokens
#   Start with `read`; add `write`, `deploy` or `read:sensitive` only when needed.
#   Instance settings (`coolify settings …`) need a root-team token.

# Self-hosted URL, or https://app.coolify.io for Coolify Cloud.
COOLIFY_URL=https://coolify.example.com
COOLIFY_TOKEN=

# Name of the CLI context this skill creates and always passes as `--context`.
# The proposed name works as is. Use one name per URL + token: with several
# instances or teams on this machine, add a suffix (skill-coolify-prod, skill-coolify-staging).
COOLIFY_CONTEXT=skill-coolify
