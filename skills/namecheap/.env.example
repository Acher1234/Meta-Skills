# Namecheap API credentials (per-workspace — next to registered SKILL.md)
# https://www.namecheap.com/myaccount/api-access/
#
# Whitelist your client IP in Namecheap → Profile → Tools → API Access.

NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
# Defaults to NAMECHEAP_USERNAME if left empty
NAMECHEAP_API_USER=
# Leave empty to let the CLI auto-detect your public IP
NAMECHEAP_CLIENT_IP=
# true = sandbox API (wizard default upstream); false = production
NAMECHEAP_SANDBOX=false
