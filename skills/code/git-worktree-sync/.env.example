# git-worktree-sync — optional settings (no secret needed).
#
# Every .env / .env.* file is always copied. SYNC_EXTRA adds other items:
# comma-separated paths or globs, relative to the repo root. A folder copies
# all its files. Already-present files in the target are never overwritten.
#
# Example:
# SYNC_EXTRA=CLAUDE.local.md,.claude/settings.local.json,.vscode/,config/*.local.json

SYNC_EXTRA=
