# Confluence credentials (per-workspace — next to registered SKILL.md)
# Resolved via SkillCred("confluence", [".env"]) + CURRENT_SKILL_DIRECTORY

CONFLUENCE_DOMAIN=company.atlassian.net
CONFLUENCE_API_PATH=/wiki/rest/api
CONFLUENCE_AUTH_TYPE=basic
CONFLUENCE_EMAIL=user@company.com
CONFLUENCE_API_TOKEN=their-token-here

# Optional:
# CONFLUENCE_PROFILE=
# CONFLUENCE_READ_ONLY=true
# CONFLUENCE_FORCE_CLOUD=
# CONFLUENCE_LINK_STYLE=
# CONFLUENCE_ENV_PATH=/absolute/path/to/.env
