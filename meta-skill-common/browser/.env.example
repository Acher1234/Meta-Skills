# Shared browser (common.browser.Browser). Read from the process environment.
# 1, true, yes, or on shows the window. 0 keeps the session headless.
DEBUG_WITH_UI_DISPLAYED=0

# Both must be set (enable is 1/true/yes/on) to pass --remote-debugging-port to Chromium.
ENABLE_REMOTE_DEBUG_PORT=0
REMOTE_DEBUG_PORT=9222

# Proxy (common.proxy).
# Empty = turned on from the keys below (DATAIMPULSE_USERNAME/PASSWORD or PROXY_URL).
# dataimpulse | http | socks5 | system force a provider; none disables the proxy.
PROXY_TYPE=
# http / socks5: host:port or scheme://host:port, credentials optional.
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=
# Exit country, e.g. il (DataImpulse).
PROXY_COUNTRY=
# Hosts that bypass the proxy, comma-separated.
NO_PROXY=

DATAIMPULSE_USERNAME=
DATAIMPULSE_PASSWORD=
DATAIMPULSE_GW=gw.dataimpulse.com
DATAIMPULSE_PROXY_PORT=823
