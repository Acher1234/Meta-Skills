# Shared HTTP client (common.http.HttpClient). Read from the skill .env, then the process environment.
# Seconds before a request times out.
HTTP_TIMEOUT=30
# Extra attempts on network errors, 502/503/504 (idempotent methods) and 429.
HTTP_RETRIES=2
# Empty uses a desktop Chrome user agent.
HTTP_USER_AGENT=
# curl_cffi browser fingerprint (chrome, safari, firefox…) for sites whose WAF blocks plain requests.
# Empty keeps requests, or the skill default. Needs curl_cffi in the skill requirements.txt.
HTTP_IMPERSONATE=
# 0 disables TLS verification. HTTP_CA_BUNDLE points at a custom CA file (corporate proxy, internal host).
HTTP_VERIFY_SSL=1
HTTP_CA_BUNDLE=
# 1 logs each request on stderr.
HTTP_DEBUG=0

# Proxy (common.proxy), shared with common.browser.
# Empty = turned on from the keys below (DATAIMPULSE_USERNAME/PASSWORD or PROXY_URL).
# dataimpulse | http | socks5 | system force a provider; none disables the proxy.
PROXY_TYPE=
# http / socks5: host:port or scheme://host:port, credentials optional.
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=
# Exit country, e.g. il (DataImpulse).
PROXY_COUNTRY=
# Hosts that bypass the proxy, comma-separated.
NO_PROXY=

DATAIMPULSE_USERNAME=
DATAIMPULSE_PASSWORD=
DATAIMPULSE_GW=gw.dataimpulse.com
DATAIMPULSE_PROXY_PORT=823
